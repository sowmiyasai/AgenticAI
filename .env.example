# App
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
JWT_SECRET=replace_with_strong_secret
CREDENTIAL_ENCRYPTION_KEY=replace_with_32_char_key

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/agentflow_ai

# Redis
REDIS_URL=redis://127.0.0.1:6379

# AI providers
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# OAuth clients
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:5000/api/integrations/oauth/gmail/callback

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:5000/api/integrations/oauth/slack/callback

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5000/api/integrations/oauth/discord/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/integrations/oauth/google-sheets/callback

# Optional local development toggles
USE_IN_MEMORY_DB=true
USE_IN_MEMORY_REDIS=true
